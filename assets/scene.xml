<scene>
    <!-- BSDF templates -->
    <bsdf name="whiteDiffuse" type="diffuse" albedoR="0.75" albedoG="0.75" albedoB="0.75" />
    <bsdf name="redDiffuse"   type="diffuse" albedoR="0.75" albedoG="0.15" albedoB="0.15" />
    <bsdf name="greenDiffuse" type="diffuse" albedoR="0.15" albedoG="0.75" albedoB="0.15" />
    <bsdf name="glass"        type="dielectric" intIOR="1.5" extIOR="1.0" />

    <!-- Materials reference a BSDF.
         Note: this engine currently requires an albedoTexture path; we reuse checkerboard.png. -->
    <material name="white"  albedoTexture="assets/checkerboard.png" bsdf="whiteDiffuse" />
    <material name="red"    albedoTexture="assets/checkerboard.png" bsdf="redDiffuse" />
    <material name="green"  albedoTexture="assets/checkerboard.png" bsdf="greenDiffuse" />
    <material name="glassM" albedoTexture="assets/checkerboard.png" bsdf="glass" />

    <!-- Cornell box geometry (already positioned in OBJ files) -->
    <mesh filename="assets/walls.obj"     material="white" />
    <mesh filename="assets/leftwall.obj"  material="red" />
    <mesh filename="assets/rightwall.obj" material="green" />

    <!-- Ceiling area light -->
    <mesh filename="assets/light.obj"
          material="white"
          isEmitter="true" radianceR="18" radianceG="18" radianceB="18" />

    <!-- Objects -->
    <mesh filename="assets/sphere1.obj" material="glassM" />
    <mesh filename="assets/sphere2.obj" material="white" />
    <mesh filename="assets/bunny.obj"
          material="red"
          scaleX="4" scaleY="4" scaleZ="4"
          rotY="15"
          posX="0.0" posY="-0.05" posZ="0.60" 

    <!-- Camera used for ray generation -->
    <camera
        eyeX="0.0" eyeY="0.8" eyeZ="2.7"
        lookAtX="0.0" lookAtY="0.8" lookAtZ="-0.2"
        upX="0" upY="1" upZ="0"
        fovY="40"
    />

    <window width="1280" height="720" />
</scene>